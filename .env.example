# ─── Network ───────────────────────────────────────────────
RPC_URL=your_amoy_rpc_url_here
POLYGON_MAINNET_RPC_URL=your_polygon_mainnet_rpc_url_here

# ─── Deployment ────────────────────────────────────────────
PRIVATE_KEY=your_deployer_private_key_here
MAINNET_DEPLOYER_PRIVATE_KEY=your_mainnet_deployer_private_key_here

# ─── Bootstrap (scripts/bootstrap.ts) ──────────────────────
JUDGE_1_ADDRESS=your_judge_1_wallet_address_here
JUDGE_2_ADDRESS=your_judge_2_wallet_address_here
JUDGE_3_ADDRESS=your_optional_judge_3_wallet_address_here
TREASURY_SAFE_ADDRESS=your_gnosis_safe_address_here
ORACLE_ADDRESS=your_oracle_public_address_here
TRANSFER_ADMIN_TO_SAFE=false

# ─── GitHub reputation oracle (oracle/githubScorer.js) ─────
ORACLE_PRIVATE_KEY=your_oracle_private_key_here
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── IPFS (Pinata) ──────────────────────────────────────────
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your-gateway.mypinata.cloud

# ─── AuditX integration ─────────────────────────────────────
AUDITX_API_URL=your_auditx_api_url_here
AUDITX_API_KEY=your_auditx_api_key_here
AUDITX_WEBHOOK_SECRET=your_auditx_webhook_secret_here

# ─── Notifications ──────────────────────────────────────────
DISCORD_ADMIN_WEBHOOK_URL=your_discord_admin_webhook_url_here

# ─── Rate limiting (Upstash) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
