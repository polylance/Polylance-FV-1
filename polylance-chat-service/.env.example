# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/polylance_db"
BACKUP_DATABASE_URL="postgresql://username:password@localhost:5432/backup_db"
CERTIFIED_PASS_DATABASE_URL="postgresql://username:password@hostname/certified_pass_polylance_audit_data"

# Server Configuration
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS="http://localhost:5173,https://polylance.github.io,https://polylance.codes"

# Authorized Role Addresses
ADMIN_ADDRESS_1="0x0000000000000000000000000000000000000001"
ADMIN_ADDRESS_2="0x0000000000000000000000000000000000000002"
ADMIN_ADDRESS_3="0x0000000000000000000000000000000000000003"
JUDGE_ADDRESS="0x0000000000000000000000000000000000000004"

# Upstash Redis (optional, for distributed rate limiting)
UPSTASH_REDIS_REST_URL="your_upstash_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# Multi-Provider Resilient RPC Pool (Server-side only — never expose in frontend)
RPC_URL_PRIMARY="https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
RPC_URL_SECONDARY="https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY"
RPC_URL_FALLBACK="https://polygon-bor-rpc.publicnode.com"
CHAIN_ID="137"

# Smart Contracts
JOB_FACTORY_ADDRESS="0x0D34F6B4Fb25662ac798A4971664E591f253d00B"
USDC_ADDRESS="0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359"
USDT_ADDRESS="0xc2132D05D31c914a87C6611C10748AEb04B58e8F"

# Monitoring & Alerting
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your_alert_channel"
# SIWE (Sign-In with Ethereum / Polygon)
SIWE_DOMAIN="polylance.codes"
SIWE_URI="https://polylance.codes"
APP_URL="https://polylance.codes"
