# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/polylance_db"

# Server Configuration
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS="http://localhost:5173,https://polylance.github.io,https://polylance.codes"

# Filebase IPFS Storage Configuration
FILEBASE_ACCESS_KEY="your_filebase_access_key"
FILEBASE_SECRET_KEY="your_filebase_secret_key"
FILEBASE_BUCKET="polylance-db"
FILEBASE_ENDPOINT="https://s3.filebase.io"
FILEBASE_REGION="auto"

# IPFS Gateway Configuration
IPFS_GATEWAY_URL="https://ipfs.filebase.io/ipfs/"
