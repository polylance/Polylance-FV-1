# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/polylance_db"
BACKUP_DATABASE_URL="postgresql://username:password@localhost:5432/backup_db"

# Server Configuration
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS="http://localhost:5173,https://polylance.github.io,https://polylance.codes"

# Authorized Role Addresses
ADMIN_ADDRESS_1="0x0000000000000000000000000000000000000001"
ADMIN_ADDRESS_2="0x0000000000000000000000000000000000000002"
ADMIN_ADDRESS_3="0x0000000000000000000000000000000000000003"
JUDGE_ADDRESS="0x0000000000000000000000000000000000000004"

# Upstash Redis (optional, for distributed rate limiting)
UPSTASH_REDIS_REST_URL="your_upstash_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"
