{
  "name": "polylance-chat-service",
  "version": "1.0.0",
  "description": "PolyLance Persistent Purge-Eligible Escrow Chat Microservice",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --name init_postgres",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eth-crypto": "^2.6.0",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "prisma": "^6.3.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^6.28.0",
    "cross-spawn": "^7.0.6",
    "tar": "^6.2.1",
    "nanoid": "^3.3.8",
    "cookie": "^0.7.2",
    "path-to-regexp": "^0.1.12",
    "body-parser": "^1.20.3",
    "send": "^0.19.0",
    "serve-static": "^1.16.0",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3"
  }
}


