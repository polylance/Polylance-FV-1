datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ConversationKeyRegistry {
  jobAddress                String   @id
  clientAddress             String
  freelancerAddress         String
  encryptedKeyForClient     String
  encryptedKeyForFreelancer String
  deletionEligible          Boolean  @default(false)
  keyShredded               Boolean  @default(false)
  createdAt                 DateTime @default(now())
}

model MessageIndex {
  id            String   @id @default(uuid())
  jobAddress    String
  messageCid    String
  senderAddress String
  sentAt        DateTime @default(now())

  @@index([jobAddress])
}

model ProtocolSharedState {
  key       String   @id @default("global_state")
  data      Json
  updatedAt DateTime @updatedAt
}

model JobRecord {
  id              String   @id
  contractAddress String?
  client          String
  freelancer      String?
  status          String
  data            Json
  onchainTokenId  Int?
  certificateNo   Int?
  mintTxHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([client])
  @@index([freelancer])
  @@index([onchainTokenId])
}

model CertificateRecord {
  id              String    @id
  jobId           String
  certType        String    // 'Patronage' | 'Verified Work'
  holderRole      String    // 'Client' | 'Freelancer'
  holderWallet    String
  certificateNo   Int?
  onchainTokenId  Int?
  contractAddress String?   @default("0x22A61f83cEB94233d30a20EEacBdEB9BCC1C2879")
  chainId         Int?      @default(137)
  mintTxHash      String?
  mintBlock       Int?
  mintedAt        DateTime?
  metadataUrl     String?
  commitmentHash  String?
  status          String    @default("Pending")
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jobId])
  @@index([holderWallet])
  @@index([onchainTokenId])
  @@index([certificateNo])
}

model ProfileRecord {
  address   String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

