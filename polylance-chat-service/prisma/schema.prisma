datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ConversationKeyRegistry {
  jobAddress                String   @id
  clientAddress             String
  freelancerAddress         String
  encryptedKeyForClient     String
  encryptedKeyForFreelancer String
  deletionEligible          Boolean  @default(false)
  keyShredded               Boolean  @default(false)
  createdAt                 DateTime @default(now())
}

model MessageIndex {
  id            String   @id @default(uuid())
  jobAddress    String
  messageCid    String
  senderAddress String
  sentAt        DateTime @default(now())

  @@index([jobAddress])
}

model FileMetadata {
  id              String   @id @default(uuid())
  ownerId         String?
  walletAddress   String
  fileName        String
  mimeType        String
  size            Int
  cid             String
  storageProvider String
  storageBucket   String
  storageKey      String
  visibility      String   @default("public")
  entityType      String?
  entityId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemState {
  key       String   @id
  cid       String
  updatedAt DateTime @updatedAt
}
