{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "node scripts/build-frontend.js",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/simulator",
      "destination": "/escrow-simulator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/Polylance-FV-1/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/Polylance-FV-1/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
