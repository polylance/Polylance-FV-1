{
  "name": "polylance",
  "version": "1.0.0",
  "description": "PolyLance Decentralized Freelance Platform",
  "main": "index.js",
  "scripts": {

    "dev": "node scripts/dev.mjs",
    "start": "node index.js",
    "build": "npm --prefix polylance-chat-service install && npm --prefix polylance-chat-service run build",
    "build:frontend": "npm --prefix frontend run build",
    "postinstall": "npm --prefix polylance-chat-service install && npx prisma generate --schema=polylance-chat-service/prisma/schema.prisma",
    "test": "npx hardhat test",
    "contracts:compile": "npx hardhat compile",
    "contracts:test": "npx hardhat test",
    "contracts:deploy:local": "npx hardhat run scripts/deploy.ts --network localhost",
    "contracts:deploy:amoy": "npx hardhat run scripts/deploy.ts --network amoy",
    "contracts:bootstrap:local": "npx hardhat run scripts/bootstrap.ts --network localhost",
    "contracts:bootstrap:amoy": "npx hardhat run scripts/bootstrap.ts --network amoy",
    "contracts:sync-abis": "node scripts/sync-abis.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": "^26.1.1",
    "chai": "^4.3.7",
    "hardhat": "^2.29.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
    "@gsap/react": "^2.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@prisma/client": "^6.3.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@splinetool/react-spline": "^4.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "eth-crypto": "^2.6.0",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "prisma": "^6.3.1",
    "socket.io": "^4.8.1",
    "viem": "^2.55.11",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^6.28.0",
    "cross-spawn": "^7.0.6",
    "tar": "^6.2.1",
    "nanoid": "^3.3.8",
    "cookie": "^0.7.2",
