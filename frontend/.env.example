# WalletConnect Project ID from https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Pinata IPFS Credentials
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_API_SECRET=your_pinata_api_secret
VITE_PINATA_JWT=your_pinata_jwt
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Role Wallet Addresses & GitHub Usernames
VITE_CLIENT_ADDRESS=0x0000000000000000000000000000000000000001
VITE_TESTER_ADDRESS=0x0000000000000000000000000000000000000002
VITE_JUDGE_ADDRESS=0x0000000000000000000000000000000000000003
VITE_JUDGE_GITHUB_USERNAME=judge_github_handle
VITE_ADMIN_ADDRESS_1=0x0000000000000000000000000000000000000004
VITE_ADMIN_ADDRESS_2=0x0000000000000000000000000000000000000005
VITE_ADMIN_ADDRESS_3=0x0000000000000000000000000000000000000006
VITE_ADMIN_GITHUB_USERNAME=admin_github_handle

# Network & RPC Config (for on-chain integration)
VITE_NETWORK=amoy
VITE_CHAIN_ID=80002
VITE_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Chat Microservice Endpoint
VITE_CHAT_SERVICE_URL=http://localhost:3001


